{
  "name": "notchapp-promo",
  "private": true,
  "version": "0.0.0",
  "description": "Promo video for NotchApp, built with Remotion from frames recorded by the app's demo mode (see ../scripts/make-promo.sh).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo ../docs/promo.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
